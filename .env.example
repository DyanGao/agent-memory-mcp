# Copy to .env. Never commit .env.

# Postgres (docker-compose.yml). Choose your own password.
POSTGRES_USER=memory_owner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agent_memory
POSTGRES_PORT=5433
DATABASE_URL=postgres://memory_owner:change-me@127.0.0.1:5433/agent_memory

# Local models via Ollama. In local mode nothing leaves this machine.
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3
DISTILL_MODEL=ollama:qwen3

# Auto-expiry for memories
RETENTION_DAYS=365

# Optional. Only used if DISTILL_MODEL selects a hosted provider.
# Setting one sends transcript-derived content to that provider.
ANTHROPIC_API_KEY=
