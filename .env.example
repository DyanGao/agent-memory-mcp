# Copy to .env. Never commit .env.

# Postgres (docker-compose.yml). Choose your own password.
POSTGRES_USER=memory_owner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agent_memory
POSTGRES_PORT=5433
DATABASE_URL=postgres://memory_owner:change-me@127.0.0.1:5433/agent_memory

# Serving connects as the restricted memory_app role, so row-level security applies.
MEMORY_APP_PASSWORD=change-me-too
APP_DATABASE_URL=postgres://memory_app:change-me-too@127.0.0.1:5433/agent_memory

# Clients send this as a bearer token. Generate one: openssl rand -hex 32
MEMORY_API_KEY=change-me-three
HOST=127.0.0.1
PORT=8787

# Local models via Ollama. In local mode nothing leaves this machine.
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3
# ollama:<model>, or anthropic:<model> such as anthropic:claude-opus-5-5
DISTILL_MODEL=ollama:qwen3

# Auto-expiry for memories
RETENTION_DAYS=365

# Optional. Docker reaches host Ollama here. Set to http://ollama:11434 with the
# `ollama` compose profile on Linux.
# OLLAMA_CONTAINER_URL=http://host.docker.internal:11434

# Optional. Sends traces and metrics to a collector. They never hold content.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional. Only used if DISTILL_MODEL selects a hosted provider.
# Setting one sends transcript-derived content to that provider.
ANTHROPIC_API_KEY=
